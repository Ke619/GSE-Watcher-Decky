{
  "name": "gse-watcher",
  "version": "1.0.0",
  "type": "module",
  "description": "Watches Proton game achievements and triggers Steam notifications via SAM",
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "watch": "rollup -c rollup.config.mjs -w",
    "deploy": "node scripts/decky.js deploy"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "@decky/ui": "^4.11.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-replace": "^5.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/react": "^18.2.0",
    "rollup": "^4.0.0",
    "rollup-plugin-external-globals": "^0.13.0",
    "tslib": "^2.6.0",
    "typescript": "^5.3.0"
  }
}